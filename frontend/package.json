{
	"name": "vroom-frontend",
	"private": true,
	"version": "1.0.0",
	"description": "VROOM Car Tracker Frontend PWA",
	"type": "module",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"sync": "svelte-kit sync",
		"check": "node scripts/type-check.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:chromium": "playwright test --project=chromium",
		"test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
		"generate-pwa-assets": "pwa-assets-generator",
		"lint": "eslint . --ext .js,.ts,.svelte",
		"lint:fix": "eslint . --ext .js,.ts,.svelte --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type-check": "node scripts/type-check.mjs --threshold error",
		"all:fix": "npm run lint:fix && npm run format",
		"validate": "npm run lint && npm run format:check && npm run type-check && npm run test && npm run build"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.50.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3": "^7.4.3",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.18.2",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.1.11",
		"autoprefixer": "^10.6.1",
		"bits-ui": "^2.19.4",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.5",
		"layerchart": "2.5.1",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"@typescript/native": "npm:typescript@7.0.2",
		"vite": "^8.3.2",
		"vitest": "^4.0.18",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1"
	},
	"overrides": {
		"serialize-javascript": "^7.0.5"
	},
	"dependencies": {
		"zod": "^4.6.5"
	}
}
