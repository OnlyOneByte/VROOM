nt-medium [&amp;:has([role=checkbox])]:pr-0 text-right" scope="col">Fuel</th><th data-slot="table-head" class="text-foreground h-10 whitespace-nowrap bg-clip-padding px-2 align-middle font-medium [&amp;:has([role=checkbox])]:pr-0 text-right" scope="col">Maintenance</th></tr></thead><tbody data-slot="table-body" class="[&amp;_tr:last-child]:border-0"><tr data-slot="table-row" class="hover:[&amp;,&amp;>svelte-css-wrapper]:[&amp;>th,td]:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors"><th data-slot="table-head" class="text-foreground h-10 whitespace-nowrap bg-clip-padding px-2 text-left align-middle [&amp;:has([role=checkbox])]:pr-0 font-normal" scope="row">Jan 2026</th> <td data-slot="table-cell" class="bg-clip-padding p-2 align-middle [&amp;:has([role=checkbox])]:pr-0 text-right whitespace-normal tabular-nums">$40.00</td><td data-slot="table-cell" class="bg-clip-padding p-2 align-middle [&amp;:has([role=checkbox])]:pr-0 text-right whitespace-normal tabular-nums">$10.00</td></tr></tbody></table></div>  <div role="list" class="flex flex-wrap gap-3 mt-3 justify-center"><div class="flex items-center gap-1.5" role="listitem"><div class="h-2.5 w-2.5 rounded-full shrink-0" aria-hidden="true" style="background-color: var(--chart-1);"></div> <span class="text-xs text-muted-foreground">Fuel</span></div><div class="flex items-center gap-1.5" role="listitem"><div class="h-2.5 w-2.5 rounded-full shrink-0" aria-hidden="true" style="background-color: var(--chart-2);"></div> <span class="text-xs text-muted-foreground">Maintenance</span></div></div> </div></div>"`;
