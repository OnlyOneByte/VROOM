# Environment Configuration
NODE_ENV=development
PORT=3001
# Bind a loopback LITERAL, not `localhost`: a name binds whichever family the resolver answers
# first (measurably ::1 on some hosts), which then refuses every client that dials 127.0.0.1 —
# including the nginx/Caddy upstreams in docs/deployment.md. Containers must use 0.0.0.0.
HOST=127.0.0.1

# Database Configuration
DATABASE_URL=./data/vroom.db

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback/google # used for login
GOOGLE_PROVIDER_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback/provider/google # used for storage provider (drive)
# GOOGLE_LINK_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback/link/google # linking a second account on Profile; unset, it is derived from GOOGLE_REDIRECT_URI

# GitHub OAuth Configuration
# Get these from GitHub Developer Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback/github
# GITHUB_LINK_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback/link/github # linking a second account on Profile; unset, it is derived from GITHUB_REDIRECT_URI

# Your own OpenID Connect provider (Authentik, Keycloak, Pocket ID...). Set all three to enable it.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback/oidc
# OIDC_LINK_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback/link/oidc # unset, it is derived from OIDC_REDIRECT_URI
# OIDC_DISPLAY_NAME=Single sign-on

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# CORS Configuration (comma-separated origins)
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://yourdomain.com

# Trusted reverse-proxy IPs or CIDR ranges (comma-separated). Rate limiting only honors
# X-Forwarded-For when the request's actual socket IP is in this list, and then reads it
# from the right, skipping trusted hops; otherwise the spoofable header is ignored.
# Leave UNSET if VROOM is exposed directly (no proxy) — that's the safe default.
# TRUSTED_PROXY_IPS=10.0.0.1,172.16.0.0/12
# A header your trusted proxy sets to the client IP, read only from a trusted socket,
# e.g. CF-Connecting-IP behind Cloudflare.
# TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# Logging Configuration
LOG_LEVEL=info

# Provider Credential Encryption
# 32-byte hex key for AES-256-GCM encryption of provider credentials
# Generate with: openssl rand -hex 32
PROVIDER_ENCRYPTION_KEY=
# To rotate the key, list keys as id=hex, current key first, and keep the old ones until
# `bun run providers:rotate-key` has re-encrypted every provider (see docs/deployment.md).
# PROVIDER_ENCRYPTION_KEYS=k2=<new 64 hex chars>,default=<the old PROVIDER_ENCRYPTION_KEY>

# Web Push (push notifications) — OPTIONAL. Leave unset to keep push OFF (the in-app
# reminder feed is unchanged). Generate a keypair with: bun run vapid:gen
# The PRIVATE key is a server secret (never shipped to the browser); the PUBLIC key is
# public-by-design. VAPID_SUBJECT is a mailto: or https: contact for the push service.
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:you@example.com

# Production Configuration (uncomment and configure for production)
# NODE_ENV=production
# PORT=3001
# HOST=0.0.0.0
# DATABASE_URL=/app/data/vroom.db
# FRONTEND_URL=https://yourdomain.com
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/callback/google
# CORS_ORIGINS=https://yourdomain.com
# LOG_LEVEL=warn
# PRIVATE_PROVIDER_ENDPOINTS=192.168.1.10:11434   # private hosts S3 endpoints and model base URLs may use
#                                                 # (self-hosted Ollama, MinIO): `allow`, or hosts, IPs or CIDRs
#                                                 # with an optional :port. Unset, LAN hosts work while the
#                                                 # server has one account, and only public https hosts after
# ADMIN_EMAILS=you@example.com   # admins' sign-in emails; when set, only admins' providers may use private targets
# DEMO_MODE=1   # offer a read-only demo garage on the landing page: anyone can open it without signing in.
#               # It is a separate seeded account, rebuilt on every start, and refuses every write

# Local testing flags (NEVER set in production — both are double-gated in config and
# refused when NODE_ENV=production). Set them inline for scripted runs against a real backend.
# ALLOW_FAKE_STORAGE=1   # enable the in-memory FakeStorageProvider seam (no real OAuth)
# DISABLE_RATE_LIMIT=1   # bypass the in-memory rate limiter so a scripted run's own
#                        # request volume doesn't exhaust the window and get 429s

# Community stats: off or local (default local). Users opt in from Settings; everyone starts opted out.
# COMMUNITY_STATS=local
# Smallest group that is ever published. May be raised, never below 10.
# COMMUNITY_STATS_MIN_GROUP=10
# What is read, what admins see and why the table is not backed up: docs/deployment.md, Community stats.
