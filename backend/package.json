{
  "name": "vroom-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Backend API for VROOM, a self-hosted vehicle cost and maintenance tracker",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnlyOneByte/VROOM.git",
    "directory": "backend"
  },
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts src/scripts/rotate-provider-keys.ts --outdir ./dist --target bun --external tesseract.js --external @tesseract.js-data/eng",
    "start": "bun dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:init": "bun src/db/init.ts",
    "db:seed": "bun src/db/init.ts --seed",
    "db:checkpoint": "bun src/db/checkpoint.ts",
    "db:checkpoint:force": "bun src/db/checkpoint.ts --force",
    "vapid:gen": "bun src/scripts/gen-vapid-keys.ts",
    "providers:rotate-key": "bun src/scripts/rotate-provider-keys.ts",
    "test": "bun test --timeout 30000 && bun run test:tz",
    "test:tz": "TZ=Pacific/Auckland bun test --timeout 30000 src/api/trips src/api/odometer src/api/expenses src/utils/__tests__/money-capture.test.ts",
    "test:postgres": "PG_PORTABILITY=1 bun test --timeout 120000 src/db/__tests__/postgres-portability.test.ts",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:musl": "./node_modules/@biomejs/cli-linux-arm64-musl/biome check src/",
    "check:musl:fix": "./node_modules/@biomejs/cli-linux-arm64-musl/biome check --write src/",
    "type-check": "tsc --noEmit",
    "all:fix": "bun run lint:fix && bun run format:fix && bun run check:fix",
    "validate": "bun run type-check && bun run check && bun run test && bun run build",
    "validate:local": "bun run type-check && bun run check:musl && bun run test && bun run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@casl/ability": "^7.1.3",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "adm-zip": "^0.6.1",
    "arctic": "^3.7.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "googleapis": "^190.0.0",
    "hono": "^4.13.19",
    "lucia": "^3.2.2",
    "oslo": "^1.2.1",
    "tesseract.js": "^7.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "qs": "^6.15.0",
    "jws": "^4.0.1",
    "google-auth-library": "10.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@electric-sql/pglite": "^0.6.0",
    "@libsql/client": "^0.18.0",
    "@types/adm-zip": "^0.6.0",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.4.5",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.3",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
