# VROOM Car Tracker - Docker Compose Environment Configuration
# Copy this file to .env, keep it beside your docker-compose.yml, and fill in your values.
# `backend/src/config.ts` is the authoritative list of what the backend reads.

# ============================================================================
# Backend Configuration
# ============================================================================
BACKEND_PORT=3001

# Google OAuth — required in production; the backend logs the missing names and exits
# at startup without them. Get them from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Login callback. Must be a route the backend serves: auth mounts under /api/v1/auth,
# and a bare /auth/... path is a 404 (the /api/* -> /api/v1/* redirect never sees it).
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback/google

# AES-256-GCM key for stored provider credentials (Drive/Sheets refresh tokens, S3
# keys, LLM keys) — required in production, exactly 64 hex characters.
# Generate with: openssl rand -hex 32
# The placeholder below is deliberately invalid, so an unedited copy of this file
# fails at startup with a named error instead of encrypting with a published key.
# Back the key up with the database: if it changes, stored credentials no longer
# decrypt and every provider has to be reconnected.
PROVIDER_ENCRYPTION_KEY=replace_me_with_openssl_rand_hex_32

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated). Doubles as the CSRF origin allowlist, so a wrong
# value makes every POST/PUT/DELETE fail.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# ============================================================================
# Frontend Configuration
# ============================================================================
FRONTEND_PORT=3000
# Backend URL as the browser sees it. The port-mapped quick start needs this; behind a
# single-domain reverse proxy or tunnel, leave it empty for same-origin calls.
PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# Cloudflare Tunnel (optional)
# ============================================================================
# Token from Cloudflare Zero Trust → Networks → Tunnels. Leave empty only if you also
# delete the `cloudflared` service from the compose file — with an empty token the
# container exits and is restarted forever.
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================================================
# Data Storage
# ============================================================================
# Host directory bind-mounted at /app/data. Create it before the first start.
DATA_PATH=./data

# ============================================================================
# Production Configuration
# ============================================================================
# Uncomment and configure these for production deployment

# FRONTEND_URL=https://yourdomain.com
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/callback/google
# CORS_ORIGINS=https://yourdomain.com
# LOG_LEVEL=warn
# Behind a single-domain proxy or tunnel, blank PUBLIC_API_URL so the browser calls the
# backend same-origin:
# PUBLIC_API_URL=
